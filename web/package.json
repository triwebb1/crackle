{
  "name": "crackle",
  "private": true,
  "version": "0.10.70",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:device": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "embed": "npm run build && node ../firmware/crackle/tools/embed-crackle.mjs",
    "size": "node tools/report-bundle-size.mjs",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "lucide-preact": "^0.468.0",
    "preact": "^10.27.3",
    "preact-render-to-string": "^6.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.18.12",
    "fake-indexeddb": "^6.2.5",
    "terser": "^5.49.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
